SetVar *result evaluate(None)

if evaluate(not hasRight('update_idea', {API_TOKEN}['rights'])) then
	SetVar API_RESPONSE 403
	SetVar *result evaluate({'message': 'Forbidden'})
	end

GetTableElement name of API_DATA
SetVar *arg_name LASTRESULT

GetTableElement description of API_DATA
SetVar *arg_description LASTRESULT

GetTableElement id of API_PARAMS
SetVar *arg_id LASTRESULT

execute app/scripts/db/updateIdea.gcs
SetVar *result evaluate({'msg': 'Idea updated successfully'})

end