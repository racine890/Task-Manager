# Check that all params are set
check var *arg_id
if $MISSING then
	print Error ------- Missing argument : *arg_id
	end

evaluate [ {*arg_id} ]
SetVar . *prepared_vars LASTRESULT

# Connect to the database
compare $DATABASE_TYPE sqlite
if $EQUAL then
	connect database $DATA_DIR/$DATABASE_NAME
if $DIFFERENT then
	connect MySQL with ( "$DATABASE_USER", "$DATABASE_PASSWORD", "$DATABASE_HOST", "$DATABASE_NAME" )

query select_one with q with *prepared_vars

compare LASTTUPLE None
if $DIFFERENT then
	evaluate tuple_to_dict({LASTTUPLE}, ('id', 'name', 'description', 'create_date', 'status', 'progress', 'creator.username', 'creator.profile_pic', 'creator.email', 'category_id', 'project_id', 'start_date', 'end_date')) =>*json
end
# Close the database
close database
end

[q]
select task.id, task.name, task.description, task.create_date, task.status, task.progression, user.username, user.profile_pic, user.email, task.category_id, task.project_id, task.start_date, task.end_date from task, user where task.creator = user.id and task.active = 1 and task.id = ? ;
[/q]
