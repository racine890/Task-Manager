SetVar *result evaluate(None)

if evaluate(not hasRight('create_category', {API_TOKEN}['rights'])) then
	SetVar API_RESPONSE 403
	SetVar *result evaluate({'message': 'Forbidden'})
	end

GetTableElement name of API_DATA
SetVar *arg_name LASTRESULT

GetTableElement description of API_DATA
SetVar *arg_description LASTRESULT

GetTableElement target of API_DATA
SetVar *arg_target LASTRESULT

GetTableElement initial_status of API_DATA
SetVar *arg_initial_status LASTRESULT

compare *arg_initial_status None
if $EQUAL then
	SetVar *arg_initial_status 0
	end

GetTableElement allowed_statuses of API_DATA
SetVar *arg_allowed_statuses LASTRESULT

compare *arg_allowed_statuses None
if $EQUAL then
	SetVar *arg_allowed_statuses '0,1,2,3,4,5,6,7,8'
	end

GetTableElement username of API_TOKEN
SetVar *arg_author LASTRESULT

execute app/scripts/db/insertCategory.gcs

SetVar *result evaluate({'msg': 'Category created successfully'})

evaluate {*arg_author} + ' created the category:' + {*arg_name} =>*log_text
execute app/scripts/system/writeLog.gcs

end