# Check that all params are set
check var *arg_start
if $MISSING then
	print Error ------- Missing argument : *arg_start
	end

check var *arg_author
if $MISSING then
	print Error ------- Missing argument : *arg_author
	end

evaluate [ {*arg_author}, {*arg_start} ]
SetVar . *prepared_vars LASTRESULT

# Connect to the database
compare $DATABASE_TYPE sqlite
if $EQUAL then
	connect database $DATA_DIR/$DATABASE_NAME
if $DIFFERENT then
	connect MySQL with ( "$DATABASE_USER", "$DATABASE_PASSWORD", "$DATABASE_HOST", "$DATABASE_NAME" )

evaluate run_sql_query_with_filters_for_tasks(self.connect, {*prepared_vars}, {*arg_filters})

SetVar *json LASTRESULT

if evaluate(len({*json}) > 0) then
	evaluate list_to_dict({*json}, ('id', 'name', 'description', 'creator', 'status', 'project_id', 'category_id', 'create_date', 'active')) =>*json

# Close the database
close database
end

constants: consts.ch
