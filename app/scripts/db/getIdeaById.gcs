# Check that all params are set
check var *arg_id
if $MISSING then
	print Error ------- Missing argument : *arg_id
	end

evaluate [ {*arg_id} ]
SetVar . *prepared_vars LASTRESULT

# Connect to the database
compare $DATABASE_TYPE sqlite
if $EQUAL then
	connect database $DATA_DIR/$DATABASE_NAME
if $DIFFERENT then
	connect MySQL with ( "$DATABASE_USER", "$DATABASE_PASSWORD", "$DATABASE_HOST", "$DATABASE_NAME" )

query select_one with q with *prepared_vars

compare LASTTUPLE None
if $DIFFERENT then
	evaluate tuple_to_dict({LASTTUPLE}, ('id', 'name', 'description', 'create_date', 'creator.username', 'creator.profile_pic', 'creator.email', 'project_id')) =>*json

# Close the database
close database
end

[q]
select idea.id, idea.name, idea.description, idea.create_date, user.username, user.profile_pic, user.email, idea.project_id from idea, user where idea.creator = user.id and idea.active = 1 and idea.id = ? ;
[/q]