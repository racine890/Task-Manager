SetVar *result evaluate(None)

GetTableElement name of API_DATA
SetVar *arg_name LASTRESULT

GetTableElement description of API_DATA
SetVar *arg_description LASTRESULT

GetTableElement start_date of API_DATA
SetVar *arg_start_date LASTRESULT

GetTableElement end_date of API_DATA
SetVar *arg_end_date LASTRESULT

GetTableElement category_id of API_DATA
SetVar *arg_category_id LASTRESULT

GetTableElement parent of API_DATA
SetVar *arg_parent LASTRESULT

GetTableElement hourly_rate of API_DATA
SetVar *arg_hourly_rate LASTRESULT

GetTableElement external of API_DATA
SetVar *arg_external LASTRESULT

GetTableElement username of API_TOKEN
SetVar *arg_author LASTRESULT

GetTableElement id of API_TOKEN
SetVar *arg_author_id LASTRESULT

execute app/scripts/db/insertProject.gcs

SetVar *result evaluate({'msg': 'Project created successfully'})

evaluate {*arg_author} + 'created the project:' + {*arg_name} =>*log_text
execute app/scripts/system/writeLog.gcs

end