# Check that all params are set
check var *arg_project_id
if $MISSING then
	print Error ------- Missing argument : *arg_project_id
	end

evaluate [ {*arg_project_id} ]
SetVar . *prepared_vars LASTRESULT

# Connect to the database
compare $DATABASE_TYPE sqlite
if $EQUAL then
	connect database $DATA_DIR/$DATABASE_NAME
if $DIFFERENT then
	connect MySQL with ( "$DATABASE_USER", "$DATABASE_PASSWORD", "$DATABASE_HOST", "$DATABASE_NAME" )

query select_all with q pass *prepared_vars

SetVar *json LASTLIST

count LASTLIST
compare LASTRESULT 0
if $DIFFERENT then
	evaluate list_to_dict({LASTLIST}, ('id', 'name', 'description', 'create_date', 'creator.username', 'creator.profile_pic', 'creator.email', 'project_id', 'active')) =>*json

# Close the database
close database
end

[q]
select idea.id, idea.name, idea.description, idea.create_date, user.username, user.profile_pic, user.email, idea.project_id, idea.active from idea, user where idea.creator = user.id and idea.active = 1 and idea.project_id = ? ;
[/q]
