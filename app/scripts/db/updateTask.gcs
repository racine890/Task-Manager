# Check that all params are set
check var *arg_name
if $MISSING then
	print Error ------- Missing argument : *arg_name
	end

check var *arg_description
if $MISSING then
	print Error ------- Missing argument : *arg_description
	end

check var *arg_id
if $MISSING then
	print Error ------- Missing argument : *arg_id
	end

check var *arg_category_id
if $MISSING then
	print Error ------- Missing argument : *arg_category_id
	end

check var *arg_project_id
if $MISSING then
	SetVar *arg_project_id None
	end

check var *arg_evaluated_hours
if $MISSING then
	SetVar *arg_evaluated_hours None
	end

evaluate [ {*arg_name}, {*arg_description}, {*arg_category_id}, {*arg_project_id}, {*arg_evaluated_hours}, {*arg_id} ]
SetVar . *prepared_vars LASTRESULT

# Connect to the database
compare $DATABASE_TYPE sqlite
if $EQUAL then
	connect database $DATA_DIR/$DATABASE_NAME
if $DIFFERENT then
	connect MySQL with ( "$DATABASE_USER", "$DATABASE_PASSWORD", "$DATABASE_HOST", "$DATABASE_NAME" )

execute query i with *prepared_vars
commit

SetVar *result *prepared_vars

# Close the database
close database
end

[i]
update task set name=?, description=?, category_id=?, project_id=?, evaluated_hours=? where id=? ;
[/i]