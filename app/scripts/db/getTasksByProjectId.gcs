# Check that all params are set
check var *arg_id
if $MISSING then
	print Error ------- Missing argument : *arg_id
	end

evaluate [ {*arg_id} ]
SetVar . *prepared_vars LASTRESULT

# Connect to the database
compare $DATABASE_TYPE sqlite
if $EQUAL then
	connect database $DATA_DIR/$DATABASE_NAME
if $DIFFERENT then
	connect MySQL with ( "$DATABASE_USER", "$DATABASE_PASSWORD", "$DATABASE_HOST", "$DATABASE_NAME" )

query select_all with q pass *prepared_vars

SetVar *json LASTLIST

count LASTLIST
compare LASTRESULT 0
if $DIFFERENT then
	evaluate list_to_dict({LASTLIST}, ('id', 'name', 'status', 'project_id', 'project_name', 'category_id', 'category_name', 'create_date', 'active', 'evaluated_hours', 'evaluation_validated')) =>*json

# Close the database
close database
end

[q]
select task.id, task.name, task.status, task.project_id, project.name as project_name, task.category_id, category.name as category_name, task.create_date, task.active, task.evaluated_hours, task.evaluation_validated from task left join project on project.id = task.project_id left join category on category.id = task.category_id where task.project_id = ? and task.active = 1 ;
[/q]
