SetVar *result evaluate(None)

GetTableElement name of API_DATA
SetVar *arg_name LASTRESULT

GetTableElement description of API_DATA
SetVar *arg_description LASTRESULT

GetTableElement mother_idea of API_DATA
SetVar *arg_idea_id LASTRESULT

GetTableElement project_id of API_DATA
SetVar *arg_project_id LASTRESULT

compare *arg_project_id None
if 0 then
	SetVar API_RESPONSE 405
	SetVar *result evaluate({'msg': 'The project is not specified'})
	end

GetTableElement category_id of API_DATA
SetVar *arg_category_id LASTRESULT

GetTableElement start_date of API_DATA
SetVar *arg_start_date LASTRESULT

GetTableElement end_date of API_DATA
SetVar *arg_end_date LASTRESULT

GetTableElement evaluated_hours of API_DATA
SetVar *arg_evaluated_hours LASTRESULT

GetTableElement username of API_TOKEN
SetVar *trace_author LASTRESULT

GetTableElement id of API_TOKEN
SetVar *arg_author LASTRESULT

execute app/scripts/db/insertTask.gcs

SetVar *result evaluate({'msg': 'Task created successfully'})

evaluate {*trace_author} + ' created the task:' + {*arg_name} =>*log_text
execute app/scripts/system/writeLog.gcs

end
