SetVar *result evaluate(None)

if evaluate(not hasRight('read_task', {API_TOKEN}['rights'])) then
	SetVar API_RESPONSE 403
	SetVar *result evaluate({'message': 'Forbidden'})
	end

GetTableElement start of API_PARAMS
SetVar *arg_start LASTRESULT

GetTableElement filters of API_DATA
SetVar *arg_filters LASTRESULT

GetTableElement id of API_TOKEN
SetVar *arg_author LASTRESULT

execute app/scripts/db/getTasksPaginated.gcs

evaluate {API_TOKEN}['username'] + ' displayed the tasks.' =>*log_text
execute app/scripts/system/writeLog.gcs

SetVar *result *json

end