SetVar *result evaluate(None)

if evaluate(not hasRight('read_settings', {API_TOKEN}['rights'])) then
	SetVar API_RESPONSE 403
	SetVar *result evaluate({'message': 'Forbidden'})
	end

GetTableElement key of API_PARAMS
SetVar *arg_key LASTRESULT

execute app/scripts/db/getConfigByKey.gcs
SetVar *result *json

end