# Update a user
SetVar *result evaluate(None)

GetTableElement oldPassword of API_DATA
SetVar *arg_oldPassword LASTRESULT

GetTableElement newPassword of API_DATA
SetVar *arg_newPassword LASTRESULT

GetTableElement id of API_TOKEN
SetVar *arg_id LASTRESULT

execute app/scripts/db/checkOldPassword.gcs
compare LASTTUPLE None
if $EQUAL then
	SetVar API_RESPONSE 400
	SetVar *result evaluate({'msg': 'Old password is incorrect'})
	end

# Persistence
execute app/scripts/db/updateUserPassword.gcs

SetVar API_RESPONSE 200
SetVar *result evaluate({'msg': 'Password updated successfully'})

end