SetVar *result evaluate(None)

if evaluate(not hasRight('delete_resource', {API_TOKEN}['rights'])) then
	SetVar API_RESPONSE 403
	SetVar *result evaluate({'message': 'Forbidden'})
	end

GetTableElement id of API_PARAMS
SetVar *arg_id LASTRESULT

execute app/scripts/ressources/getById.gcs
GetTableElement path of *json

evaluate delete_file({LASTRESULT})

execute app/scripts/db/deleteRessource.gcs
SetVar *result evaluate({'msg': 'Ressource deleted successfully'})

end