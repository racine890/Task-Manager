# Check that all params are set
check var *arg_id
if $MISSING then
	print Error ------- Missing argument : *arg_id
	end

check var *arg_user_id
if $MISSING then
	print Error ------- Missing argument : *arg_user_id
	end

evaluate [ {*arg_id}, {*arg_user_id} ]
SetVar . *prepared_vars LASTRESULT


# Connect to the database
compare $DATABASE_TYPE sqlite
if $EQUAL then
	connect database $DATA_DIR/$DATABASE_NAME
if $DIFFERENT then
	connect MySQL with ( "$DATABASE_USER", "$DATABASE_PASSWORD", "$DATABASE_HOST", "$DATABASE_NAME" )

query select_one with q with *prepared_vars

SetVar *json {'msg': 'Project not found'}
SetVar API_RESPONSE 404

compare LASTTUPLE None
if $DIFFERENT then
	evaluate tuple_to_dict({LASTTUPLE}, ('id', 'name', 'description', 'creator', 'status', 'start_date', 'end_date', 'effective_start', 'effective_end', 'parent', 'category_id', 'category_name', 'create_date', 'active', 'hourly_rate', 'external')) =>*json
	SetVar API_RESPONSE 200

# Close the database
close database
end

[q]
select project.id, project.name, project.description, project.creator, project.status, project.start_date,
project.end_date, project.effective_start, project.effective_end, project.parent, project.category_id, category.name as category_name,
project.create_date, project.active, project.hourly_rate, project.external from project left join category on category.id = project.category_id where project.id = ? and project.id in
(select project_id from user_project where user_id = ?);
[/q]