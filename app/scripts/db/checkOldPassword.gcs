# Check that all params are set
check var *arg_oldPassword
if $MISSING then
	print Error ------- Missing argument : *arg_oldPassword
	end

check var *arg_id
if $MISSING then
	print Error ------- Missing argument : *arg_id
	end

evaluate [ {*arg_id}, hashlib.sha256({*arg_oldPassword}.encode()).hexdigest() ]
SetVar . *prepared_vars LASTRESULT

# Connect to the database
compare $DATABASE_TYPE sqlite
if $EQUAL then
	connect database $DATA_DIR/$DATABASE_NAME
if $DIFFERENT then
	connect MySQL with ( "$DATABASE_USER", "$DATABASE_PASSWORD", "$DATABASE_HOST", "$DATABASE_NAME" )

query select_one with q with *prepared_vars

# Close the database
close database
end

[q]
select 1 from user where id = ? and password = ? and active = true ;
[/q]

constants: consts.ch