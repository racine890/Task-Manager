# Check that all params are set
check var *arg_id
if $MISSING then
	print Error ------- Missing argument : *arg_id
	end

evaluate [ {*arg_id} ]
SetVar . *prepared_vars LASTRESULT

# Connect to the database
compare $DATABASE_TYPE sqlite
if $EQUAL then
	connect database $DATA_DIR/$DATABASE_NAME
if $DIFFERENT then
	connect MySQL with ( "$DATABASE_USER", "$DATABASE_PASSWORD", "$DATABASE_HOST", "$DATABASE_NAME" )

query select_all with q pass *prepared_vars

SetVar *json LASTLIST

count LASTLIST
compare LASTRESULT 0
if $DIFFERENT then
	evaluate list_to_dict({LASTLIST}, ('id', 'name', 'status', 'start_date', 'end_date', 'effective_start', 'effective_end', 'category_id', 'category_name', 'create_date', 'active', 'hourly_rate', 'external')) =>*json

# Close the database
close database
end

[q]
select project.id, project.name, project.status, project.start_date, project.end_date, project.effective_start, project.effective_end, project.category_id, category.name as category_name, project.create_date, project.active, project.hourly_rate, project.external from project left join category on category.id = project.category_id where project.parent = ? and project.active = 1 ;
[/q]
