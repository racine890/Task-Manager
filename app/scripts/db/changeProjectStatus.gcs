# Check that all params are set
check var *arg_id
if $MISSING then
	print Error ------- Missing argument : *arg_id
	end

check var *arg_status
if $MISSING then
	print Error ------- Missing argument : *arg_status
	end

evaluate [ {*arg_status}, {*arg_id} ]
SetVar . *prepared_vars LASTRESULT

# Connect to the database
compare $DATABASE_TYPE sqlite
if $EQUAL then
	connect database $DATA_DIR/$DATABASE_NAME
if $DIFFERENT then
	connect MySQL with ( "$DATABASE_USER", "$DATABASE_PASSWORD", "$DATABASE_HOST", "$DATABASE_NAME" )

execute query i with *prepared_vars

evaluate [ {*arg_id} ]
SetVar . *prepared_vars LASTRESULT

switch *arg_status
if 2 then
	execute query u with *prepared_vars
if 5 then
	execute query u2 with *prepared_vars

commit

SetVar *result *prepared_vars

# Close the database
close database
end

[i]
update project set status = ? where id = ?;
[/i]

[u]
update project set effective_start = CURRENT_TIMESTAMP where id = ?;
[/u]

[u2]
update project set effective_end = CURRENT_TIMESTAMP where id = ?;
[/u2]