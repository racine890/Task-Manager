SetVar *result evaluate(None)

if evaluate(not hasRight('read_project', {API_TOKEN}['rights'])) then
	SetVar API_RESPONSE 403
	SetVar *result evaluate({'message': 'Forbidden'})
	end

GetTableElement id of API_PARAMS
SetVar *arg_id LASTRESULT

GetTableElement id of API_TOKEN
SetVar *arg_user_id LASTRESULT

execute app/scripts/db/getProjectById.gcs
SetVar *result *json

evaluate {API_TOKEN}['username'] + ' a affiché le projet:' + {*arg_id} =>*log_text
execute app/scripts/system/writeLog.gcs
end
