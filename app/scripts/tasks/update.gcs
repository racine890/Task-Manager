SetVar *result evaluate(None)

GetTableElement id of API_PARAMS
SetVar *arg_id LASTRESULT

GetTableElement id of API_TOKEN
SetVar *arg_user_id LASTRESULT

GetTableElement name of API_DATA
SetVar *arg_name LASTRESULT

GetTableElement description of API_DATA
SetVar *arg_description LASTRESULT

GetTableElement category_id of API_DATA
SetVar *arg_category_id LASTRESULT

GetTableElement project_id of API_DATA
SetVar *arg_project_id LASTRESULT

GetTableElement evaluated_hours of API_DATA
SetVar *arg_evaluated_hours LASTRESULT

GetTableElement priority of API_DATA
SetVar *arg_priority LASTRESULT

# User has update_task right - can update any task
if evaluate(hasRight('update_task', {API_TOKEN}['rights'])) then
	execute app/scripts/db/updateTask.gcs
	SetVar *result evaluate({'msg': 'Task updated successfully'})

# User doesn't have update_task, check update_my_task
if evaluate((not hasRight('update_my_task', {API_TOKEN}['rights'])) and (not hasRight('update_task', {API_TOKEN}['rights']))) then
	SetVar API_RESPONSE 403
	SetVar *result evaluate({'message': 'Forbidden'})
	end

# User has update_my_task only - verify ownership
compare $DATABASE_TYPE sqlite
if $EQUAL then
	connect database $DATA_DIR/$DATABASE_NAME
if $DIFFERENT then
	connect MySQL with ( "$DATABASE_USER", "$DATABASE_PASSWORD", "$DATABASE_HOST", "$DATABASE_NAME" )

evaluate [ {*arg_id}, {*arg_user_id} ]
SetVar . *check_vars LASTRESULT

compare $DATABASE_TYPE sqlite
if $EQUAL then
	query select_one with check_owner_sqlite with *check_vars
if $DIFFERENT then
	query select_one with check_owner_mysql with *check_vars

compare LASTTUPLE None
if $EQUAL then
	SetVar API_RESPONSE 403
	SetVar *result evaluate({'message': 'Forbidden'})
	close database
	end

close database

# Ownership verified - update the task
execute app/scripts/db/updateTask.gcs

SetVar *result evaluate({'msg': 'Task updated successfully'})

end

[check_owner_sqlite]
SELECT 1 FROM task WHERE id = ? AND creator = ? AND active = 1;
[/check_owner_sqlite]

[check_owner_mysql]
SELECT 1 FROM task WHERE id = ? AND creator = ? AND active = 1;
[/check_owner_mysql]