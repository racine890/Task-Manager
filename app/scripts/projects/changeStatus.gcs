SetVar *result evaluate(None)

if evaluate(not hasRight('change_project_status', {API_TOKEN}['rights'])) then
	SetVar API_RESPONSE 403
	SetVar *result evaluate({'msg': 'Forbidden'})
	end

GetTableElement id of API_PARAMS
SetVar *arg_id LASTRESULT

GetTableElement status of API_PARAMS
SetVar *arg_status LASTRESULT

execute app/scripts/db/changeProjectStatus.gcs
SetVar *result evaluate({'msg': 'Project status changed successfully'})

end