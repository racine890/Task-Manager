SetVar *result evaluate(None)

if evaluate(not hasRight('delete_idea', {API_TOKEN}['rights'])) then
	SetVar API_RESPONSE 403
	SetVar *result evaluate({'message': 'Forbidden'})
	end

GetTableElement id of API_PARAMS
SetVar *arg_id LASTRESULT

execute app/scripts/db/deleteIdea.gcs
SetVar *result evaluate({'msg': 'Idea deleted successfully'})

end