SetVar *result evaluate(None)

if evaluate(not hasRight('delete_category', {API_TOKEN}['rights'])) then
	SetVar API_RESPONSE 403
	SetVar *result evaluate({'message': 'Forbidden'})
	end

GetTableElement id of API_PARAMS
SetVar *arg_id LASTRESULT

execute app/scripts/db/deleteCategory.gcs

SetVar *result evaluate({'msg': 'Category deleted successfully'})

end