SetVar *result evaluate(None)

GetTableElement id of API_PARAMS
SetVar *arg_id LASTRESULT

GetTableElement id of API_TOKEN
SetVar *arg_user_id LASTRESULT

# User has delete_idea right - can delete any idea
if evaluate(hasRight('delete_idea', {API_TOKEN}['rights'])) then
	execute app/scripts/db/deleteIdea.gcs
	SetVar *result evaluate({'msg': 'Idea deleted successfully'})

# User doesn't have delete_idea, check delete_my_idea
if evaluate((not hasRight('delete_idea', {API_TOKEN}['rights'])) and (not hasRight('delete_my_idea', {API_TOKEN}['rights']))) then
	SetVar API_RESPONSE 403
	SetVar *result evaluate({'message': 'Forbidden'})
	end

# User has delete_my_idea only - verify ownership
compare $DATABASE_TYPE sqlite
if $EQUAL then
	connect database $DATA_DIR/$DATABASE_NAME
if $DIFFERENT then
	connect MySQL with ( "$DATABASE_USER", "$DATABASE_PASSWORD", "$DATABASE_HOST", "$DATABASE_NAME" )

evaluate [ {*arg_id}, {*arg_user_id} ]
SetVar . *check_vars LASTRESULT

compare $DATABASE_TYPE sqlite
if $EQUAL then
	query select_one with check_owner_sqlite with *check_vars
if $DIFFERENT then
	query select_one with check_owner_mysql with *check_vars

compare LASTTUPLE None
if $EQUAL then
	SetVar API_RESPONSE 403
	SetVar *result evaluate({'message': 'Forbidden'})
	close database
	end

close database

# Ownership verified - delete the idea
execute app/scripts/db/deleteIdea.gcs
SetVar *result evaluate({'msg': 'Idea deleted successfully'})

end

[check_owner_sqlite]
SELECT 1 FROM idea WHERE id = ? AND creator = ? AND active = 1;
[/check_owner_sqlite]

[check_owner_mysql]
SELECT 1 FROM idea WHERE id = ? AND creator = ? AND active = 1;
[/check_owner_mysql]