SetVar *result evaluate(None)

if evaluate(not hasRight('create_resource', {API_TOKEN}['rights'])) then
	SetVar API_RESPONSE 403
	SetVar *result evaluate({'message': 'Forbidden'})
	end

GetTableElement name of API_DATA
SetVar *arg_name LASTRESULT

GetTableElement path of API_DATA
evaluate {LASTRESULT}[{LASTRESULT}.rindex('/'):]
SetVar *arg_path LASTRESULT

GetTableElement username of API_TOKEN
SetVar *arg_author LASTRESULT

execute app/scripts/db/insertRessource.gcs

SetVar *result evaluate({'msg': 'Resource created successfully'})

evaluate {*arg_author} + 'created the resource:' + {*arg_name} =>*log_text
execute app/scripts/system/writeLog.gcs

end