# Check that all params are set
check var *arg_id
if $MISSING then
	print Error ------- Missing argument : *arg_id
	end

# Check that all params are set
check var *arg_user_id
if $MISSING then
	print Error ------- Missing argument : *arg_user_id
	end

evaluate [ {*arg_id}, {*arg_user_id} ]
SetVar . *prepared_vars LASTRESULT

# Connect to the database
compare $DATABASE_TYPE sqlite
if $EQUAL then
	connect database $DATA_DIR/$DATABASE_NAME
if $DIFFERENT then
	connect MySQL with ( "$DATABASE_USER", "$DATABASE_PASSWORD", "$DATABASE_HOST", "$DATABASE_NAME" )

query select_one with test pass *prepared_vars
compare LASTTUPLE None
if 0 then
	SetVar API_RESPONSE 404
	close database
	end

execute query q pass *prepared_vars

SetVar *result *prepared_vars

# Close the database
close database
end

[q]
update user_project set active = 0 where project_id = ? and user_id = ? ;
[/q]

[test]
select user_project.id, project.name, user.username
from user_project, project, user
where user_project.project_id = project.id
and user_project.user_id = user.id
and user_project.active = 1 and project_id = ? and user_id = ? ;
[/test]
