SetVar *result evaluate(None)

GetTableElement id of API_PARAMS
SetVar *arg_id LASTRESULT

GetTableElement id of API_TOKEN
SetVar *arg_user_id LASTRESULT

# User has update_resource right - can update any resource
if evaluate(hasRight('update_resource', {API_TOKEN}['rights'])) then
	GetTableElement name of API_DATA
	SetVar *arg_name LASTRESULT

	GetTableElement path of API_DATA
	evaluate {LASTRESULT}[{LASTRESULT}.rindex('/'):]
	SetVar *arg_path LASTRESULT

	execute app/scripts/db/updateRessource.gcs
	SetVar *result evaluate({'msg': 'Resource updated successfully'})
	end

# User doesn't have update_resource, check update_my_resource
if evaluate(not hasRight('update_my_resource', {API_TOKEN}['rights'])) then
	SetVar API_RESPONSE 403
	SetVar *result evaluate({'message': 'Forbidden'})
	end

# User has update_my_resource only - verify ownership
compare $DATABASE_TYPE sqlite
if $EQUAL then
	connect database $DATA_DIR/$DATABASE_NAME
if $DIFFERENT then
	connect MySQL with ( "$DATABASE_USER", "$DATABASE_PASSWORD", "$DATABASE_HOST", "$DATABASE_NAME" )

evaluate [ {*arg_id}, {*arg_user_id} ]
SetVar . *check_vars LASTRESULT

compare $DATABASE_TYPE sqlite
if $EQUAL then
	query select_one with check_owner_sqlite with *check_vars
if $DIFFERENT then
	query select_one with check_owner_mysql with *check_vars

compare LASTTUPLE None
if $EQUAL then
	SetVar API_RESPONSE 403
	SetVar *result evaluate({'message': 'Forbidden'})
	close database
	end

close database

# Ownership verified - update the resource
GetTableElement name of API_DATA
SetVar *arg_name LASTRESULT

GetTableElement path of API_DATA
evaluate {LASTRESULT}[{LASTRESULT}.rindex('/'):]
SetVar *arg_path LASTRESULT

execute app/scripts/db/updateRessource.gcs

SetVar *result evaluate({'msg': 'Resource updated successfully'})

end

[check_owner_sqlite]
SELECT 1 FROM resource WHERE id = ? AND creator = ? AND active = 1;
[/check_owner_sqlite]

[check_owner_mysql]
SELECT 1 FROM resource WHERE id = ? AND creator = ? AND active = 1;
[/check_owner_mysql]